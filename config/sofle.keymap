#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

// With OS set to Spanish (ES) layout:
// SEMI → ñ/Ñ  |  SQT → ´ dead acute  |  BSLH → ç/Ç

#define BASE    0
#define SYM     1
#define NAV     2
#define FUN     3
#define COLEMAK 4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        fun_layer { if-layers = <SYM NAV>; then-layer = <FUN>; };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
        };
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
            layers = <BASE COLEMAK>;
        };
        combo_caps {
            timeout-ms = <50>;
            key-positions = <25 34>;
            bindings = <&caps_word>;
            layers = <BASE COLEMAK>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // QWERTY + HRM (previous base, Layer 0)
        base_layer {
            display-name = "QWERTY";
            bindings = <
&kp GRAVE  &kp N1         &kp N2       &kp N3         &kp N4        &kp N5                           &kp N6    &kp N7          &kp N8        &kp N9       &kp N0          &kp EQUAL
&kp ESC    &kp Q          &kp W        &kp E          &kp R         &kp T                            &kp Y     &kp U           &kp I         &kp O        &kp P           &kp BSPC
&kp TAB    &hml LGUI A    &hml LALT S  &hml LCTRL D   &hml LSHIFT F &kp G                            &kp H     &hmr RSHIFT J   &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z          &kp X        &kp C          &kp V         &kp B      &none      &none      &kp N     &kp M           &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT
                           &kp LGUI     &kp LALT       &kp LCTRL     &mo SYM    &kp BSPC   &kp SPACE  &mo NAV   &kp ENTER       &kp RALT      &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp PG_UP PG_DN>;
        };

        // SYM: hold left inner thumb
        // Row 1: ! @ # $ % | ^ & *
        // Home:  ( ) { } [ ] | < > = + - _
        // Row 3: | \ ; : '   | " / ?
        sym_layer {
            display-name = "sym";
            bindings = <
&trans     &trans        &trans      &trans         &trans       &trans                           &trans        &trans        &trans     &trans      &trans          &trans
&trans     &kp EXCL      &kp AT      &kp HASH       &kp DLLR     &kp PRCNT                        &kp CARET     &kp AMPS      &kp ASTRK  &trans      &trans          &trans
&kp LPAR   &kp RPAR      &kp LBRC    &kp RBRC       &kp LBKT     &kp RBKT                         &kp LS(COMMA) &kp LS(DOT)   &kp EQUAL  &kp PLUS    &kp MINUS       &kp UNDER
&trans     &kp PIPE      &kp BSLH    &kp SEMI       &kp COLON    &kp SQT    &trans     &trans     &kp DQT       &kp FSLH      &kp QMARK  &trans      &trans          &trans
                          &trans      &trans         &trans       &trans     &trans     &trans     &trans        &trans        &trans     &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(Z) LC(Y)>, <&inc_dec_kp PG_UP PG_DN>;
        };

        // NAV: hold right inner thumb
        // Home: 1 2 3 4 5 | 6 7 8 9 0
        // Bottom right: ← ↓ ↑ →
        nav_layer {
            display-name = "nav";
            bindings = <
&trans     &trans        &trans      &trans         &trans       &trans                           &trans    &trans        &trans        &trans      &trans          &trans
&trans     &trans        &trans      &trans         &trans       &trans                           &trans    &trans        &trans        &trans      &trans          &trans
&trans     &kp N1        &kp N2      &kp N3         &kp N4       &kp N5                           &kp N6    &kp N7        &kp N8        &kp N9      &kp N0          &trans
&trans     &trans        &trans      &trans         &trans       &trans     &trans     &trans     &trans    &kp LEFT      &kp DOWN      &kp UP      &kp RIGHT       &trans
                          &trans      &trans         &trans       &trans     &trans     &trans     &trans    &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };

        // FUN: SYM + NAV simultaneously
        // Row 0: F1-F11  |  outer right = F12
        // Row 1: Q=QWERTY W=Colemak toggle
        // Row 2: BT profiles  |  outer right = BT_CLR
        fun_layer {
            display-name = "fun";
            bindings = <
&trans     &kp F1        &kp F2       &kp F3         &kp F4       &kp F5                           &kp F6    &kp F7        &kp F8        &kp F9      &kp F10         &kp F11
&trans     &to BASE      &to COLEMAK  &trans         &trans       &trans                           &trans    &trans        &trans        &trans      &trans          &kp F12
&trans     &bt BT_SEL 0  &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3 &bt BT_SEL 4                   &trans    &trans        &trans        &trans      &trans          &trans
&trans     &trans        &trans       &trans         &trans       &trans     &trans     &trans     &trans    &trans        &trans        &trans      &trans          &bt BT_CLR
                          &trans       &trans         &trans       &trans     &trans     &trans     &trans    &trans        &trans        &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp PG_UP PG_DN>;
        };

        // Colemak-DHm + ES (Layer 4)
        // SEMI → ñ on base (row 1 outer right) and bottom row inner right
        // SQT  → ´ dead acute (outer home row right)
        colemak_layer {
            display-name = "colemak";
            bindings = <
&kp GRAVE  &kp N1        &kp N2      &kp N3         &kp N4       &kp N5                           &kp N6    &kp N7        &kp N8        &kp N9      &kp N0          &kp BSPC
&kp ESC    &kp Q         &kp W       &kp F          &kp P        &kp B                            &kp J     &kp L         &kp U         &kp Y       &kp SEMI        &kp EQUAL
&kp TAB    &hml LCTRL A  &hml LALT R &hml LSHIFT S  &hml LGUI T  &kp G                            &kp M     &hmr RGUI N   &hmr RSHIFT E &hmr RALT I &hmr RCTRL O    &kp SQT
&kp LSHFT  &kp Z         &kp X       &kp C          &kp D        &kp V      &none      &none      &kp SEMI  &kp H         &kp COMMA     &kp DOT     &kp FSLH        &kp RSHFT
                          &kp LGUI    &kp LALT       &kp LCTRL    &mo SYM    &kp BSPC   &kp SPACE  &mo NAV   &kp ENTER     &kp RALT      &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
