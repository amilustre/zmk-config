/*
 * CLEANUP FIRMWARE — settings reset
 * Todas las teclas = &settings_reset (borra settings BLE y reinicia).
 * Uso: flashear en la mitad periférica que no conecta, pulsar CUALQUIER
 * tecla, esperar al reinicio, y reflashear el firmware normal.
 * El behavior se ejecuta localmente en la mitad (opaque), sin central.
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "CLEAN";
            bindings = <
&settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset                     &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset
&settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset                     &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset
&settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset                     &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset
&settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &none  &none        &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset
                 &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset                       &settings_reset  &settings_reset  &settings_reset  &settings_reset  &settings_reset
            >;
        };
    };
};
