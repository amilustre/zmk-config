#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

// With OS set to Spanish (ES) layout:
// SEMI → ñ/Ñ  |  SQT → ´ dead acute  |  BSLH → ç/Ç
// Layer priority (high → low): FUN(3) > NAV(2) > SYM(1) > BASE(0)
// Toggle: FUN row1 Q=QWERTY

#define BASE    0
#define SYM     1
#define NAV     2
#define FUN     3
#define GAME    4
#define NIX     5

// Layer priority (high → low): NIX(5) > GAME(4) > FUN(3) > NAV(2) > SYM(1) > BASE(0)
// Toggle: FUN row1 Y=GAME layer, U=NIX layer
// GAME layer = 100% plain &kp (no hold-taps: games misbehave with dual-function keys)
// NIX layer = Hyprland shortcuts with SUPER (LG) pre-embedded, one key per action

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        fun_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            hold-trigger-on-release;
        };

    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp ESC>;
            layers = <0>;
        };

        combo_caps {
            timeout-ms = <50>;
            key-positions = <25 34>;
            bindings = <&caps_word>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // QWERTY + HRM  (Layer 0 — default)

        base_layer {
            display-name = "QWERTY";
            bindings = <
&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4         &kp N5                         &kp N6  &kp N7         &kp N8        &kp N9       &kp N0          &kp EQUAL
&kp ESC    &kp Q        &kp W        &kp E         &kp R          &kp T                          &kp Y   &kp U          &kp I         &kp O        &kp P           &kp BSPC
&kp TAB    &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &kp G                          &kp H   &hmr RSHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V          &kp B   &none       &none      &kp N   &kp M          &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT
                        &kp LGUI     &kp LALT      &kp LCTRL      &mo 2   &kp BSPC    &kp SPACE  &mo 1   &kp ENTER      &kp RALT      &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };

        // SYM: hold right inner thumb  (Layer 1)
        // All keycodes tuned for Windows Spanish (ES) layout.
        // Row 1: !       @       #       $     %     | ^(dead)  &       *
        // Home:  (       )       {       }     [     ] | <       >       =     +     -       _
        // Row 3: |       \\       ;       :     '       | "       /       ?
        // Note: ^ at LS(LBKT) is a dead key in ES — press then SPACE for literal ^.

        sym_layer {
            display-name = "sym";
            bindings = <
&trans      &trans      &trans         &trans         &trans       &trans                        &trans        &trans        &trans         &trans    &trans    &trans
&trans      &kp EXCL    &kp RA(N2)     &kp RA(N3)     &kp DLLR     &kp PRCNT                     &kp LS(LBKT)  &kp LS(N6)    &kp LS(RBKT)   &trans    &trans    &trans
&kp LS(N8)  &kp LS(N9)  &kp RA(N7)     &kp RA(N0)     &kp RA(N8)   &kp RA(N9)                    &kp NUBS      &kp LS(NUBS)  &kp LS(N0)     &kp RBKT  &kp FSLH  &kp LS(FSLH)
&trans      &kp RA(N1)  &kp RA(GRAVE)  &kp LS(COMMA)  &kp LS(DOT)  &kp MINUS   &trans    &trans  &kp LS(N2)    &kp LS(N7)    &kp LS(MINUS)  &trans    &trans    &trans
                        &trans         &trans         &trans       &trans      &trans    &trans  &trans        &trans        &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LC(Z) LC(Y)>,
                <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };

        // NAV: hold left inner thumb  (Layer 2)
        // Row 0-1: F1-F12
        // Row 2: Number row
        // Row 3: Vim arrows H← J↓ K↑ L→

        nav_layer {
            display-name = "nav";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                     &trans  &trans  &trans  &trans  &trans  &trans
&kp F7  &kp F8  &kp F9  &kp F10 &kp F11 &kp F12                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                     &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
                &kp LEFT_CONTROL  &kp LEFT_ALT  &trans  &trans  &kp DEL    &trans  &trans  &trans    &trans    &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };

        // FUN: SYM + NAV simultaneously  (Layer 3 — highest priority, overrides everything)
        // Row 0: F1-F11  |  outer right = F12
        // Row 1: Q=QWERTY | Y=toggle GAME (Project Zomboid) | U=toggle NIX (Hyprland nixtopus)
        // Row 2: BT profiles
        // Row 3: RGB controls + BT_CLR

        fun_layer {
            display-name = "fun";
            bindings = <
&trans  &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                             &kp F6           &kp F7           &kp F8           &kp F9             &kp F10  &kp F11
&trans  &to 0            &none            &trans           &trans           &trans                             &tog GAME        &tog NIX         &trans           &trans             &trans   &kp F12
&trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                       &trans           &trans           &trans           &trans             &trans   &trans
&trans  &rgb_ug RGB_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &trans    &trans  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &ext_power EP_TOG  &trans   &bt BT_CLR
                         &trans           &trans           &trans           &trans           &trans    &trans  &trans           &trans           &trans           &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };

        // GAME: toggle (FUN row1 Y)  (Layer 4)
        // Project Zomboid — plain &kp ONLY (no hold-taps, no layer-taps).
        // Left half = combat zone (WASD + actions), thumb keys = attack/inventory,
        // right half = calm-time management (hotbar, map, pause). Escape hatch: thumb &to 0.

        game_layer {
            display-name = "game";
            // GAME v2 (12-08, feedback Alexis): TODO en la mitad izquierda
            // (la derecha va a &none para no disparar teclas de BASE en
            // combate). WASD desplazado una columna a la derecha: la D cae
            // donde está la F en un teclado normal (D@F). E interactuar
            // arriba de S, R recargar arriba de D, F linterna, K calmar,
            // G caminar. Q (gritar) se OMITE a propósito: atrae zombis y
            // queda en posición natural de accidente. Hotbar 1-8.
            bindings = <
&kp N1      &kp N2         &kp N3         &kp N4         &kp N5         &kp N6                            &none         &none          &none          &none          &none         &none
&kp N7      &kp N8         &kp W          &kp E          &kp R          &kp K                            &none         &none          &none          &none          &none         &none
&kp ESC     &kp TAB        &kp A          &kp S          &kp D          &kp F                            &none         &none          &none          &none          &none         &none
&kp LSHFT   &kp Z          &kp C          &kp V          &kp B          &kp G    &none      &none         &none         &none          &none          &none          &none        &none
                        &to 0           &kp M          &kp P          &kp SPACE      &kp TAB                          &none         &none          &none          &none        &none
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        // NIX: toggle (FUN row1 U)  (Layer 5 — highest priority)
        // nixtopus Hyprland shortcuts, SUPER pre-embedded (one key per action):
        // Row 0: Print=region shot | 1-9,0=workspace direct | = = fullscreen shot
        // Row 1: Esc=wlogout | Q-W-E-R-T,Y-U-I-O-P = move window to ws 1-10
        // Row 2: D=rofi F=fullscreen | H=movewindow HDMI, J/K=focusmonitor, L=lock
        // Row 3: V=floating | . = movewindow DP-3 | thumb Enter = alacritty

        nix_layer {
            display-name = "nix";
            bindings = <
&kp PRINTSCREEN  &kp LG(N1)     &kp LG(N2)     &kp LG(N3)     &kp LG(N4)     &kp LG(N5)                        &kp LG(N6)     &kp LG(N7)     &kp LG(N8)     &kp LG(N9)     &kp LG(N0)  &kp LG(PRINTSCREEN)
&kp LG(ESC)      &kp LG(LS(N1)) &kp LG(LS(N2)) &kp LG(LS(N3)) &kp LG(LS(N4)) &kp LG(LS(N5))                    &kp LG(LS(N6)) &kp LG(LS(N7)) &kp LG(LS(N8)) &kp LG(LS(N9)) &kp LG(LS(N0)) &trans
&trans           &trans         &trans         &kp LG(D)      &kp LG(F)      &trans                             &kp LG(H)      &kp LG(LEFT)   &kp LG(RIGHT)  &kp LG(L)      &trans        &trans
&trans           &trans         &trans         &trans         &kp LG(V)      &trans    &none      &none          &trans         &trans         &trans         &kp LG(DOT)    &trans        &trans
                        &trans         &trans         &trans         &trans         &trans                          &trans        &to 0          &kp LG(RETURN) &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp LC(LEFT) LC(RIGHT)>;
        };
    };
};
